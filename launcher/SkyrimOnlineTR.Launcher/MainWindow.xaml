<Window x:Class="SkyrimOnlineTR.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SkyrimOnlineTR.Launcher"
        Title="Skyrim Online TR" Width="1200" Height="740" ResizeMode="CanMinimize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Night}" Foreground="{StaticResource Wool}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <DataTemplate x:Key="NewsTemplate">
            <StackPanel Margin="0,0,0,30" MaxWidth="660" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Date, Converter={x:Static local:TrDate.Instance}}" Style="{StaticResource Small}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="30"/>
                <TextBlock Text="{Binding Body}" Style="{StaticResource Body}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HomeNewsTemplate">
            <StackPanel Margin="0,0,0,26" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}"/>
                <TextBlock Text="{Binding Body}" Style="{StaticResource Body}"/>
                <TextBlock Text="{Binding Date, Converter={x:Static local:TrDate.Instance}}" Style="{StaticResource Small}" Margin="0,6,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- 2/2 twill, the weave of a plain wool cloak; barely there -->
        <DrawingBrush x:Key="Twill" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1C2230" Geometry="M0,0 H8 V8 H0 Z"/>
                    <GeometryDrawing Brush="#08EAE4D6" Geometry="M0,0 H2 V1 H0 Z M1,1 H3 V2 H1 Z M2,2 H4 V3 H2 Z M3,3 H5 V4 H3 Z M4,4 H6 V5 H4 Z M5,5 H7 V6 H5 Z M6,6 H8 V7 H6 Z M7,7 H8 V8 H7 Z M0,7 H1 V8 H0 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Seam}" BorderThickness="1" Background="{StaticResource Twill}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="104"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Top bar: name, menu, player, window controls -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Skyrim Online TR" FontFamily="{StaticResource Display}" FontSize="32"
                           VerticalAlignment="Center" Margin="40,0,48,4"/>

                <StackPanel x:Name="Nav" Grid.Column="1" Orientation="Horizontal" Height="46" VerticalAlignment="Center" Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource NavItem}" Content="Ana sayfa" Tag="PageHome" IsChecked="True" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Haberler" Tag="PageNews" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Yama notları" Tag="PagePatch" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Modlar" Tag="PageMods" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Sunucu" Tag="PageServer" Checked="OnNav"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="Ayarlar" Tag="PageSettings" Checked="OnNav"/>
                </StackPanel>

                <StackPanel x:Name="UserChip" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="Collapsed">
                    <Ellipse Width="30" Height="30" Fill="{StaticResource Seam}"/>
                    <Ellipse Width="30" Height="30" Margin="-30,0,0,0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="UserName" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,2"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Küçült" AutomationProperties.Name="Küçült">
                        <Rectangle Width="11" Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="OnClose" ToolTip="Kapat" AutomationProperties.Name="Kapat">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>

                <Border Grid.ColumnSpan="4" Style="{StaticResource Rule}" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- Pages -->
            <Grid x:Name="Pages" Grid.Row="1">

                <!-- Home: latest news beside the server at a glance -->
                <Grid x:Name="PageHome" Margin="40,40,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,56,0">
                        <StackPanel>
                            <!-- The newest item is the headline; the next ones sit under it quietly -->
                            <StackPanel x:Name="HomeLead" Margin="0,0,0,40" MaxWidth="660" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="52" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Body}" Style="{StaticResource Body}" FontSize="19" LineHeight="29" Foreground="{StaticResource Wool}"/>
                                <TextBlock Text="{Binding Date, Converter={x:Static local:TrDate.Instance}}" Style="{StaticResource Small}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <ItemsControl x:Name="HomeNewsList" ItemTemplate="{StaticResource HomeNewsTemplate}"/>
                            <TextBlock x:Name="HomeNewsEmpty" Style="{StaticResource Body}" Visibility="Collapsed"
                                       Text="Henüz duyuru yok. Yenilikler burada ve Discord'da paylaşılır."/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Small}" Text="Sunucu"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="{StaticResource Seam}" VerticalAlignment="Center" Margin="0,2,9,0"/>
                            <TextBlock x:Name="ServerStatus" FontSize="20" FontWeight="Medium" Text="Kontrol ediliyor"/>
                            <TextBlock x:Name="ServerPing" Style="{StaticResource Small}" FontSize="17" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                        </StackPanel>
                        <TextBlock x:Name="ServerName" Style="{StaticResource Small}" Margin="18,0,0,0"/>

                        <Border Style="{StaticResource Rule}" Margin="0,18"/>

                        <TextBlock Style="{StaticResource Small}" Text="Mod paketi"/>
                        <TextBlock x:Name="HomeModlistText" FontSize="20" FontWeight="Medium" Margin="0,2,0,0"/>

                        <Border Style="{StaticResource Rule}" Margin="0,18"/>

                        <Button Style="{StaticResource LinkButton}" Content="Kurallar ve Discord" Tag="PageServer" Click="OnGoTo"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="PageNews" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,36,40,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Haberler"/>
                        <TextBlock Style="{StaticResource Lead}" Text="Sunucudan duyurular, etkinlikler ve bakım saatleri."/>
                        <ItemsControl x:Name="NewsList" ItemTemplate="{StaticResource NewsTemplate}"/>
                        <TextBlock x:Name="NewsEmpty" Style="{StaticResource Body}" Visibility="Collapsed"
                                   Text="Henüz duyuru yok. Yenilikler burada ve Discord'da paylaşılır."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PagePatch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,36,40,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Yama notları"/>
                        <TextBlock Style="{StaticResource Lead}" Text="Her güncellemede neyin değiştiği. Launcher yeni sürümü kendisi kurar."/>
                        <ItemsControl x:Name="PatchList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,30">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Version}" Style="{StaticResource Heading}" FontSize="30"/>
                                            <TextBlock Text="{Binding Date, Converter={x:Static local:TrDate.Instance}}" Style="{StaticResource Small}" VerticalAlignment="Bottom" Margin="14,0,0,11"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6" MaxWidth="680" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- the weld diamond from the band -->
                                                        <Rectangle Width="6" Height="6" Fill="{StaticResource Weld}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,9,0,0">
                                                            <Rectangle.RenderTransform>
                                                                <RotateTransform Angle="45" CenterX="3" CenterY="3"/>
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" Foreground="{StaticResource Wool}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PatchEmpty" Style="{StaticResource Body}" Visibility="Collapsed" Text="Henüz yama notu yayımlanmadı."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageMods" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,36,40,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Modlar"/>
                        <TextBlock x:Name="ModsLead" Style="{StaticResource Lead}"
                                   Text="Sunucuda herkesin oyununda aynı modlar olmalı. Launcher bunları kendisi kurar ve günceller; elle mod ekleme."/>
                        <ItemsControl x:Name="ModList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="760" HorizontalAlignment="Left">
                                        <Grid Margin="0,12,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Medium" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Author}" Style="{StaticResource Small}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Small}" FontSize="16" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding About}" Style="{StaticResource Body}"/>
                                        </Grid>
                                        <Border Style="{StaticResource Rule}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ModsEmpty" Style="{StaticResource Body}" Visibility="Collapsed" Text="Mod listesi sunucudan henüz gelmedi."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageServer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,36,40,24">
                        <TextBlock x:Name="ServerTitle" Style="{StaticResource PageTitle}" Text="Sunucu"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="ServerDot2" Width="10" Height="10" Fill="{StaticResource Seam}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                            <TextBlock x:Name="ServerStatus2" FontSize="20" FontWeight="Medium" Text="Kontrol ediliyor"/>
                            <Button Style="{StaticResource LinkButton}" Content="Yeniden dene" Click="OnRefreshServer" VerticalAlignment="Center" Margin="18,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ServerPing2" Style="{StaticResource Body}"/>
                        <TextBlock x:Name="ServerAddress" Style="{StaticResource Small}" Margin="0,4,0,0"/>

                        <StackPanel x:Name="DiscordBlock" Margin="0,28,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                                       Text="Duyurular, hata bildirimleri ve oyuncu buluşmaları Discord sunucumuzda."/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Discord'u aç" Click="OnOpenDiscord"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Heading}" FontSize="30" Text="Kurallar" Margin="0,40,0,12"/>
                        <ItemsControl x:Name="RulesList" AlternationCount="1000">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10" MaxWidth="700" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{StaticResource Display}" FontSize="20" Foreground="{StaticResource Weld}"
                                                   Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={x:Static local:OneBased.Instance}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" Foreground="{StaticResource Wool}" Margin="0,1,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RulesEmpty" Style="{StaticResource Body}" Visibility="Collapsed" Text="Kurallar yakında burada olacak."/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,36,40,32">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Ayarlar"/>
                        <TextBlock Style="{StaticResource Lead}" Text="Bu ayarlar yalnız Skyrim Online TR kurulumunu etkiler. Steam'deki Skyrim'ine dokunulmaz."/>

                        <!-- Each section: what it is on the left, the controls on the right -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*" MaxWidth="700"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,32,0">
                                <TextBlock Style="{StaticResource Heading}" Text="Görüntü"/>
                                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="Oyunu bir sonraki açışında geçerli olur."/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <StackPanel x:Name="DisplayPanel">
                                    <TextBlock Style="{StaticResource Small}" Text="Pencere" Margin="0,4,0,8"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="ModeFullscreen" Style="{StaticResource Choice}" GroupName="WinMode" Content="Tam ekran"/>
                                        <RadioButton x:Name="ModeBorderless" Style="{StaticResource Choice}" GroupName="WinMode" Content="Çerçevesiz pencere"/>
                                        <RadioButton x:Name="ModeWindowed" Style="{StaticResource Choice}" GroupName="WinMode" Content="Pencere"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Small}" Text="Çözünürlük" Margin="0,10,0,8"/>
                                    <WrapPanel x:Name="ResolutionChoices"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Görüntü ayarlarını kaydet" Click="OnSaveDisplay"/>
                                        <TextBlock x:Name="DisplayNote" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="DisplayUnavailable" Style="{StaticResource Body}" Visibility="Collapsed" Margin="0,4,0,0"
                                           Text="Oyun kurulunca pencere ve çözünürlük ayarları burada açılır."/>
                            </StackPanel>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Rule}" Margin="0,28"/>

                            <StackPanel Grid.Row="2" Margin="0,0,32,0">
                                <TextBlock Style="{StaticResource Heading}" Text="Kurulum"/>
                                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="Oyun, modlar ve indirilenler bu klasörde durur."/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock x:Name="InstallDirText" FontSize="17" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource LinkButton}" Content="Klasörü aç" Click="OnOpenInstallDir" Margin="0,0,20,0"/>
                                    <Button x:Name="InstallDirButton" Style="{StaticResource LinkButton}" Content="Kurulum yerini değiştir" Click="OnChangeInstallDir"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Body}" Margin="0,22,0,10"
                                           Text="Oyun çöküyorsa ya da bir dosya bozulduysa onar. Her dosya kontrol edilir, eksik ya da bozuk olanlar yeniden indirilir."/>
                                <Button x:Name="RepairButton" Style="{StaticResource SecondaryButton}" Content="Dosyaları onar" Click="OnRepair"/>
                            </StackPanel>

                            <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Rule}" Margin="0,28"/>

                            <StackPanel Grid.Row="4" Margin="0,0,32,0">
                                <TextBlock Style="{StaticResource Heading}" Text="İndirilenler"/>
                                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="Güncellemede kullanılan mod arşivleri."/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <TextBlock x:Name="CacheText" Style="{StaticResource Body}" Margin="0,4,0,10"/>
                                <Button x:Name="ClearCacheButton" Style="{StaticResource SecondaryButton}" Content="İndirilenleri sil" Click="OnClearCache"/>
                            </StackPanel>

                            <Border Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource Rule}" Margin="0,28"/>

                            <StackPanel Grid.Row="6" Margin="0,0,32,0">
                                <TextBlock Style="{StaticResource Heading}" Text="Sorun bildirme"/>
                                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="Discord'da hata bildirirken son kayıt dosyasını ekle."/>
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Çökme kayıtları" Click="OnOpenCrashLogs" Margin="0,0,20,0"/>
                                <Button Style="{StaticResource LinkButton}" Content="Launcher kayıtları" Click="OnOpenLauncherLogs"/>
                            </StackPanel>

                            <Border Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource Rule}" Margin="0,28"/>

                            <TextBlock Grid.Row="8" Style="{StaticResource Heading}" Text="Hesap ve sürüm" Margin="0,0,32,0"/>
                            <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,4,0,0">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Small}" FontSize="16" Text="Mod paketi"/>
                                    <TextBlock x:Name="ModlistVersionText" Grid.Column="1" FontSize="16"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource Small}" FontSize="16" Text="Launcher" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="LauncherVersionText" Grid.Row="1" Grid.Column="1" FontSize="16" Margin="0,4,0,0"/>
                                </Grid>
                                <Button Style="{StaticResource LinkButton}" Content="Discord hesabından çık" Click="OnLogout"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Status and the main action, always in view -->
            <Grid Grid.Row="2" Margin="40,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Style="{StaticResource Rule}" VerticalAlignment="Top" Margin="-40,0,-32,0"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock x:Name="PhaseText" FontFamily="{StaticResource Display}" FontSize="30" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DetailText" Style="{StaticResource Small}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="PercentText" Grid.Column="1" FontFamily="{StaticResource Display}" FontSize="30"
                           Foreground="{StaticResource WoolDim}" VerticalAlignment="Center" Margin="0,0,28,4"/>
                <Button x:Name="ActionButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Width="232" Height="58"
                        Content="Bekle" IsEnabled="False" Click="OnAction" IsDefault="True"/>
            </Grid>

            <!-- The woven band: the whole window's spine, and the progress bar -->
            <local:WovenBand x:Name="Progress" Grid.Row="3" Value="0"/>
        </Grid>
    </Border>
</Window>
