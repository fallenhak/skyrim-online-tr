<Window x:Class="SkyrimOnlineTR.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skyrim Online TR" Width="1080" Height="640" ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border CornerRadius="10" BorderBrush="#553F2E14" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <RadialGradientBrush Center="0.3,0.25" GradientOrigin="0.3,0.25" RadiusX="1.1" RadiusY="1.1">
                <GradientStop Color="#2A2620" Offset="0"/>
                <GradientStop Color="#15130F" Offset="0.45"/>
                <GradientStop Color="#080706" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid x:Name="Root" MouseLeftButtonDown="OnDrag">
            <!-- Moon glow -->
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-80,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1FD8E2F0" Offset="0"/>
                        <GradientStop Color="#00D8E2F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Mountain ranges, far to near -->
            <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="360" IsHitTestVisible="False">
                <Canvas Width="1080" Height="360">
                    <Path Fill="#1B1F26" Opacity="0.85"
                          Data="M0,210 L90,150 L150,175 L240,90 L300,130 L380,60 L450,120 L520,95 L600,150 L690,70 L760,125 L850,85 L930,140 L1000,105 L1080,150 L1080,360 L0,360 Z"/>
                    <Path Fill="#EEF2F8" Opacity="0.10"
                          Data="M240,90 L262,106 L250,112 L232,100 Z M380,60 L404,80 L386,84 L368,72 Z M690,70 L716,92 L696,96 L676,84 Z M850,85 L872,104 L852,106 L838,96 Z"/>
                    <Path Fill="#13151A"
                          Data="M0,260 L70,215 L160,245 L260,170 L330,215 L420,180 L510,230 L600,175 L700,235 L790,190 L880,240 L980,200 L1080,240 L1080,360 L0,360 Z"/>
                    <Path Fill="#0B0B0D"
                          Data="M0,305 L110,270 L220,300 L330,262 L460,300 L560,275 L690,310 L820,270 L950,300 L1080,280 L1080,360 L0,360 Z"/>
                </Canvas>
            </Viewbox>

            <!-- Snow -->
            <Canvas x:Name="SnowLayer" IsHitTestVisible="False" ClipToBounds="True"/>

            <!-- Bottom shade so text stays readable -->
            <Border VerticalAlignment="Bottom" Height="230" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00060505" Offset="0"/>
                        <GradientStop Color="#E0060505" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="36,20,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/app.ico" Width="30" Height="30" Margin="0,0,12,0"/>
                        <TextBlock Text="SKYRIM ONLINE" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource GoldGradient}" VerticalAlignment="Center" Language="en"/>
                        <Border BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="2" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TR" FontFamily="{StaticResource Display}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldBright}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="UserChip" Visibility="Collapsed" Background="#66000000" BorderBrush="#33C9A45C" BorderThickness="1"
                                CornerRadius="16" Padding="4,4,12,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="24" Height="24" Margin="0,0,8,0">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="UserName" Foreground="{StaticResource Parchment}" FontSize="13" VerticalAlignment="Center"/>
                                <Button Content="Çıkış" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnLogout"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Küçült">
                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="OnClose" ToolTip="Kapat">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="0,40,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="Kuzeyin kapıları açık." FontFamily="{StaticResource Display}" FontSize="40"
                                   Foreground="{StaticResource Parchment}" TextWrapping="Wrap">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Türkiye'nin Skyrim rol yapma sunucusu. Yolun seni nereye götürürse." FontSize="15"
                                   Foreground="{StaticResource Muted}" Margin="2,10,0,0"/>

                        <!-- Rune divider -->
                        <Grid Width="260" HorizontalAlignment="Left" Margin="2,26,0,18">
                            <Rectangle Height="1" Fill="{StaticResource GoldDim}" VerticalAlignment="Center"/>
                            <Path Data="M0,6 L6,0 L12,6 L6,12 Z" Fill="#15130F" Stroke="{StaticResource Gold}" StrokeThickness="1" HorizontalAlignment="Center"/>
                        </Grid>

                        <ItemsControl x:Name="NewsList" MaxWidth="520" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource GoldBright}"/>
                                            <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Body}" FontSize="13" Foreground="{StaticResource Parchment}" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Realm card -->
                    <Border Grid.Column="1" VerticalAlignment="Top" Background="{StaticResource Panel}" BorderBrush="#40C9A45C"
                            BorderThickness="1" CornerRadius="6" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="DİYAR" FontFamily="{StaticResource Display}" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="ServerName" Text="Skyrim Online TR" FontFamily="{StaticResource Display}" FontSize="18"
                                       Foreground="{StaticResource Parchment}" Margin="0,4,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ServerStatus" Text="Kontrol ediliyor…" Foreground="{StaticResource Parchment}" FontSize="13"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#33C9A45C" Margin="0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Oyun sürümü" Foreground="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock x:Name="ModlistVersionText" Grid.Column="1" Text="—" Foreground="{StaticResource Parchment}" FontSize="12"/>
                                <TextBlock Grid.Row="1" Text="Launcher" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                <TextBlock x:Name="LauncherVersionText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Parchment}" FontSize="12" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Text="Kurulum" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                <Button x:Name="InstallDirButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource LinkButton}" Margin="0,6,0,0"
                                        Click="OnChangeInstallDir" ToolTip="Kurulum klasörünü değiştir">
                                    <TextBlock x:Name="InstallDirText" TextTrimming="CharacterEllipsis" MaxWidth="170" TextDecorations="Underline"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer: progress + action -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,40,10">
                        <Grid>
                            <TextBlock x:Name="PhaseText" FontFamily="{StaticResource Display}" FontSize="15" Foreground="{StaticResource GoldBright}"/>
                            <TextBlock x:Name="PercentText" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource Parchment}"/>
                        </Grid>
                        <ProgressBar x:Name="Progress" Style="{StaticResource GoldProgress}" Margin="0,8,0,8" Maximum="1" Visibility="Hidden"/>
                        <TextBlock x:Name="DetailText" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="ActionButton" Grid.Column="1" Style="{StaticResource PlayButton}" Width="300" Height="64"
                            Content="YÜKLENİYOR" IsEnabled="False" Click="OnAction"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
